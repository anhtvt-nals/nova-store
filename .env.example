# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_URL=/api
# Browser sessions are capped locally after this many days. The default is 3.
VITE_SESSION_MAX_AGE_DAYS=3
WEB_PORT=5173

# Nest API
API_PORT=3001
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co

# Use a new Supabase sb_secret_ key. SUPABASE_SERVICE_ROLE_KEY is also accepted for legacy projects.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Admin roles must be assigned explicitly to an existing auth_user_id in the database.
# Never promote accounts by matching an email address at request time.
ADMIN_REQUIRE_MFA=true

# At least 32 random characters; used to encrypt proxy-provider API keys at rest.
PROVIDER_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Automatic order provisioning. Keep false until migration 202608140006 is applied
# and the master GOST rendezvous server is reachable from provider sandboxes.
PROXY_PROVISIONING_ENABLED=false
PROXY_PROVISIONING_POLL_MS=2000
PROXY_PROVISIONING_CONCURRENCY=2
# After an ungraceful worker shutdown, a running job can be reclaimed after this lease expires.
PROXY_PROVISIONING_LOCK_SECONDS=60
# Due nodes are atomically queued for replacement by every running API instance.
PROXY_ROTATION_POLL_MS=30000
# Queue sequential replacements by default; increase only when replacement
# capacity/headroom is available for each parallel sandbox.
PROXY_ROTATION_BATCH_SIZE=1
# Retry a failed rotation quickly (5s, 10s, 20s, then capped at 30s).
# Keep this separate from initial provisioning retries, which remain slower.
PROXY_ROTATION_RETRY_BASE_SECONDS=5
PROXY_ROTATION_RETRY_MAX_SECONDS=30
# HTTPS endpoint received directly from each sandbox GOST observer. Use a
# distinct random 32+ character value; node-scoped HMAC tokens are generated.
PROXY_USAGE_OBSERVER_URL=https://api.example.com/api/internal/proxy-usage
PROXY_USAGE_OBSERVER_SECRET=replace-with-a-random-secret-at-least-32-chars
# Active orders are atomically marked expired and their sandboxes are terminated.
PROXY_EXPIRATION_POLL_MS=30000
PROXY_EXPIRATION_BATCH_SIZE=100

# Bound DB growth from completed rotations and released capacity leases.
PROXY_RUNTIME_RETENTION_POLL_MS=21600000
PROXY_RUNTIME_RETENTION_BATCH_SIZE=500
PROXY_INSTANCE_RETENTION_DAYS=14
PROXY_LEASE_RETENTION_DAYS=7
PROXY_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars

# GOST v3 runtime shared by the master and every compute provider adapter.
GOST_VERSION=3.2.6
GOST_MASTER_HOST=proxy.example.com
# Public hostname returned to customers. Ports are leased dynamically from this range.
GOST_PUBLIC_HOST=proxy.example.com
GOST_TUNNEL_PORT_MIN=30000
GOST_TUNNEL_PORT_MAX=39999
GOST_RENDEZVOUS_PORT=28443
GOST_METRICS_PORT=9000
GOST_REPLACEMENT_READY_TIMEOUT_MS=60000

# Each new GitHub provider key gets its own public `nodenesia-gost-<key-id>`
# repository and workflow automatically. No template owner is required.
# Public HTTPS base URL of the API control-plane route, without a trailing slash.
GITHUB_CONTROL_PLANE_URL=https://api.example.com/api/internal/github-runners
GITHUB_OIDC_AUDIENCE=nodenesia-gost-control-plane
GITHUB_READY_TIMEOUT_MS=180000
# Master and sandbox transports must match. Raw TCP has the lowest overhead.
GOST_TUNNEL_TRANSPORT=tcp
GOST_TUNNEL_USERNAME=replace-with-internal-tunnel-user
GOST_TUNNEL_PASSWORD=replace-with-internal-tunnel-password
GOST_LOCAL_SOCKS_PORT=1080
# Optional per-node GOST v3 limits. Leave bandwidth empty and use 0 connections for unlimited.
GOST_NODE_BANDWIDTH_IN=
GOST_NODE_BANDWIDTH_OUT=
GOST_NODE_MAX_CONNECTIONS=0

# Static residential proxy is an isolated GOST v3.3+ process. It does not share
# the sandbox rendezvous service or its 30000-39999 port allocation range.
# The Web API must stay loopback-only; Nest is the only process allowed to call it.
STATIC_RESIDENTIAL_ENABLED=false
STATIC_GOST_API_ADDR=127.0.0.1:18081
STATIC_GOST_METRICS_ADDR=127.0.0.1:19000
STATIC_GOST_USAGE_POLL_MS=1000
# A proxy must fail this many full SOCKS5 authentication + egress checks before
# it is disabled. Keep at least 2 to avoid removing capacity for a transient outage.
STATIC_RESIDENTIAL_HEALTH_FAILURE_THRESHOLD=2
# Firewall the public static SOCKS5 range on the master VPS. Each order always
# has 5 ports and Nest enforces its selected 1GB, 3GB, or 5GB shared soft cap
# from GOST metrics.
STATIC_GOST_PORT_MIN=10000
STATIC_GOST_PORT_MAX=20000
STATIC_GOST_SERVICE_USER=nodenesia-gost
STATIC_GOST_BANDWIDTH_PER_PORT=5MB
STATIC_GOST_BANDWIDTH_PER_CONNECTION=10MB
STATIC_GOST_MAX_CONNECTIONS_PER_PORT=150
STATIC_GOST_MAX_CONNECTIONS_PER_IP=20
STATIC_GOST_REQUESTS_PER_SECOND_PER_PORT=100
STATIC_GOST_REQUESTS_PER_SECOND_PER_IP=20

# E2B adapter defaults. API keys remain managed in Admin > Provider API keys.
E2B_TEMPLATE=base
E2B_SANDBOX_TIMEOUT_MINUTES=60
E2B_RENEW_BEFORE_MINUTES=10

# Runloop adapter. Create provider code `runloop` and add its API key in Admin
# > Providers; the stored key is encrypted exactly like E2B provider keys.
# The adapter enforces X_SMALL and a fixed one-hour Devbox lifetime.
RUNLOOP_API_BASE_URL=https://api.runloop.ai
RUNLOOP_BLUEPRINT=
RUNLOOP_READY_TIMEOUT_MS=120000

# Blaxel adapter. Create provider code `blaxel` and add a key as
# BLAXEL_WORKSPACE|BLAXEL_API_KEY in Admin > Provider API keys.
BLAXEL_API_BASE_URL=https://api.blaxel.ai/v0
BLAXEL_API_VERSION=2026-04-16
BLAXEL_IMAGE=blaxel/base-image:latest
# One region or a | separated pool. One region is selected randomly per sandbox.
BLAXEL_REGION=us-pdx-1|eu-fra-1|eu-lon-1|us-was-1
BLAXEL_SANDBOX_MEMORY_MB=1024
BLAXEL_READY_TIMEOUT_MS=180000
# Dedicated WSS rendezvous used only by Blaxel nodes. Set this up with
# scripts/install-gost-blaxel-wss-master.sh and point Cloudflare Origin Rules
# for tunnel.nodenesia.id:443 to the private origin port.
BLAXEL_GOST_MASTER_HOST=tunnel.nodenesia.id
BLAXEL_GOST_RENDEZVOUS_PORT=443
BLAXEL_GOST_TUNNEL_TRANSPORT=wss
BLAXEL_GOST_WS_PATH=/ws
BLAXEL_GOST_TUNNEL_USERNAME=replace-with-a-dedicated-blaxel-tunnel-user
BLAXEL_GOST_TUNNEL_PASSWORD=replace-with-a-dedicated-blaxel-tunnel-password
# Dedicated egress gateways are managed in Admin > Blaxel egress gateways.
# Each gateway is linked to one Blaxel provider API key/account and allocator
# reserves an unused gateway per active node. Do not put gateway pools in .env.
# One-off test only (not stored in the provider vault). The test script creates
# a temporary Blaxel sandbox and binds GOST to port 39999 until Ctrl+C.
# BLAXEL_TEST_KEY=your-workspace|your-api-key
# Set true only for an isolated dedicated-egress test. The script creates a
# temporary VPC, gateway and IPv4 then deletes all of them on Ctrl+C/SIGTERM.
# BLAXEL_TEST_DEDICATED_EGRESS=true
# Set true only when you need time for manual proxy testing; default cleans on success.
# BLAXEL_TEST_KEEP_ALIVE=true
# BEAM_TEST_KEEP_ALIVE=true

# NodeOps CreateOS one-off sandbox/GOST test. It is independent from the
# database and destroys its temporary sandbox when the command completes.
# It uses the same WSS master pattern as Blaxel; use separate credentials in
# production so the tunnel can be revoked without affecting other providers.
NODEOPS_SANDBOX_BASE_URL=https://api.sb.createos.sh
NODEOPS_SANDBOX_SHAPE=s-1vcpu-1gb
NODEOPS_SANDBOX_ROOTFS=devbox:1
NODEOPS_READY_TIMEOUT_MS=180000
NODEOPS_GOST_MASTER_HOST=tunnel.example.com
NODEOPS_GOST_RENDEZVOUS_PORT=443
NODEOPS_GOST_TUNNEL_TRANSPORT=wss
NODEOPS_GOST_WS_PATH=/ws
NODEOPS_GOST_TUNNEL_USERNAME=replace-with-a-dedicated-nodeops-tunnel-user
NODEOPS_GOST_TUNNEL_PASSWORD=replace-with-a-dedicated-nodeops-tunnel-password
# NODEOPS_TEST_API_KEY=your-createos-api-key
# NODEOPS_TEST_KEEP_ALIVE=true
# NODEOPS_TEST_KEEP_ON_FAILURE=true
# NODEOPS_TEST_PORT=39996
